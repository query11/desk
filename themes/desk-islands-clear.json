// Desk 浮岛 · 高通透：和默认主题布局相同，着色更淡、明暗统一更弱，透出更多壁纸的颜色和明暗。
// 壁纸很亮或很暗时文字可能不够清晰，可以在设置窗口里把「明暗统一」调大。
//
// 规则写法兼容 Windhawk「Windows 11 Taskbar Styler」的选择器语法：
//   target:  "父元素 > 子元素"，元素写成 类型#名称，可以用 [序号] 和 [属性=值]
//   styles:  "属性=值"，或者 "属性:=<XAML 对象/>"
// $名称 引用下面的常量；常量可以分别给浅色模式和深色模式设置不同的值。
// Desk 设置窗口里的滑块调整的就是这些常量（调整后的值保存在设置里，不会改动这个文件）。
// 保存这个文件后，Desk 会立即重新应用。
{
  "name": "Desk 浮岛 · 高通透",
  "description": "和「Desk 浮岛」相同的布局，着色更淡、更通透，壁纸的颜色更鲜艳。",

  "constants": {
    // ---- 任务栏浮岛 ----
    // 圆角，以及岛与任务栏上下边缘的距离（单位：像素，按 100% 缩放计）
    "radius": "10",
    "gap": "4",

    // 材质：
    //   Blur        模糊强度（高斯模糊的标准差）
    //   Tint        着色颜色，Opacity 是着色浓度（0~1，越大越接近纯色）
    //   Luminosity  明暗统一（0~1）：把背景的亮度拉向着色的亮度，越大文字越清晰、越不受壁纸影响
    //   Saturation  饱和度（1 为原样，越大壁纸的颜色越鲜艳）
    //   Noise       颗粒感（0~0.1），让模糊更像真实的亚克力材质
    "islandBlur": "24",
    "islandTint": { "light": "#F3F3F3", "dark": "#202020" },
    "islandOpacity": { "light": "0.3", "dark": "0.3" },
    "islandLuminosity": { "light": "0.65", "dark": "0.5" },
    "islandSaturation": "1.6",
    "islandNoise": "0.025",

    // 岛的描边：顶部的高光和底部的暗边，让岛看起来像一块玻璃
    "islandStroke": {
      "light": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#B3FFFFFF\" Offset=\"0\"/><GradientStop Color=\"#33FFFFFF\" Offset=\"0.5\"/><GradientStop Color=\"#1F000000\" Offset=\"1\"/></LinearGradientBrush>",
      "dark": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#40FFFFFF\" Offset=\"0\"/><GradientStop Color=\"#14FFFFFF\" Offset=\"0.5\"/><GradientStop Color=\"#0AFFFFFF\" Offset=\"1\"/></LinearGradientBrush>"
    },

    // ---- 开始菜单 ----
    "menuRadius": "8",
    "menuBlur": "22",
    "menuTint": { "light": "#F3F3F3", "dark": "#1C1C1C" },
    "menuOpacity": { "light": "0.1", "dark": "0.15" },
    "menuLuminosity": { "light": "0.5", "dark": "0.35" },
    "menuSaturation": "1.7",
    "menuNoise": "0.025",
    "menuStroke": {
      "light": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#99FFFFFF\" Offset=\"0\"/><GradientStop Color=\"#33FFFFFF\" Offset=\"0.3\"/><GradientStop Color=\"#1A000000\" Offset=\"1\"/></LinearGradientBrush>",
      "dark": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#4DFFFFFF\" Offset=\"0\"/><GradientStop Color=\"#1AFFFFFF\" Offset=\"0.3\"/><GradientStop Color=\"#0DFFFFFF\" Offset=\"1\"/></LinearGradientBrush>"
    },

    "islandMaterial": "<DeskBlur BlurAmount=\"$islandBlur\" TintColor=\"$islandTint\" TintOpacity=\"$islandOpacity\" TintLuminosityOpacity=\"$islandLuminosity\" TintSaturation=\"$islandSaturation\" NoiseOpacity=\"$islandNoise\"/>",
    "menuMaterial": "<DeskBlur BlurAmount=\"$menuBlur\" TintColor=\"$menuTint\" TintOpacity=\"$menuOpacity\" TintLuminosityOpacity=\"$menuLuminosity\" TintSaturation=\"$menuSaturation\" NoiseOpacity=\"$menuNoise\"/>"
  },

  "taskbar": {
    // 任何时候都生效的规则
    "common": [],

    // 平时：浮岛
    "floating": [
      // 应用岛：宽度跟随图标数量，居中；左右各留 250 的空间给托盘岛
      {
        "target": "Taskbar.TaskbarFrame",
        "styles": ["Width=Auto", "HorizontalAlignment=Center", "Margin=250,0,250,0"]
      },
      // 图标离岛的左右边缘留一点距离
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid",
        "styles": ["Padding=8,0,8,0"]
      },
      // 背景层向左右延伸回岛的边缘，上下各收进 $gap，形成“浮起来”的岛
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground",
        "styles": ["Margin=-8,$gap,-8,$gap"]
      },
      // 岛的材质：亚克力模糊 + 圆角 + 玻璃描边
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundFill",
        "styles": ["Fill:=$islandMaterial", "RadiusX=$radius", "RadiusY=$radius", "Stroke:=$islandStroke", "StrokeThickness=1"]
      },
      // 去掉原生任务栏顶部的那条分隔线
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke",
        "styles": ["Visibility=Collapsed"]
      },
      // 小组件（天气）按钮在自动宽度下的多余边距
      {
        "target": "Taskbar.AugmentedEntryPointButton#AugmentedEntryPointButton > Taskbar.TaskListButtonPanel#ExperienceToggleButtonRootPanel",
        "styles": ["Margin=0"]
      },
      // 托盘岛
      {
        "target": "SystemTray.SystemTrayFrame > Grid#SystemTrayFrameGrid, SystemTray.SystemTrayFrame > StackPanel#SystemTrayFrameGrid",
        "styles": [
          "Background:=$islandMaterial",
          "BorderBrush:=$islandStroke",
          "BorderThickness=1",
          "CornerRadius=$radius",
          "Margin=0,$gap,8,$gap",
          "Padding=8,0,4,0"
        ]
      }
    ],

    // 有窗口最大化、并且选择了“恢复成整条任务栏”时：
    // 这里留空，表示恢复成系统原生的整条任务栏。
    "maximized": []
  },

  "startMenu": {
    "common": [
      // 开始菜单（以及手机连接侧栏）的背景：通透的毛玻璃 + 玻璃描边
      {
        "target": "Border#AcrylicBorder",
        "styles": ["Background:=$menuMaterial", "BorderBrush:=$menuStroke", "BorderThickness=1", "CornerRadius=$menuRadius"]
      },
      // 系统叠加在亚克力上的一层，会让背景发灰发闷
      {
        "target": "Border#AcrylicOverlay",
        "styles": ["Visibility=Collapsed"]
      },
      // 阴影的圆角和背景保持一致
      {
        "target": "Border#StartDropShadow, Border#RootGridDropShadow, Border#RightCompanionDropShadow",
        "styles": ["CornerRadius=$menuRadius"]
      }
    ]
  }
}
