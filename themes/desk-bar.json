// Desk 整条毛玻璃：保留原生的整条任务栏布局，只把背景换成亚克力质感的实时模糊。
{
  "name": "Desk 整条毛玻璃",
  "description": "原生布局的整条任务栏，背景换成实时模糊；开始菜单为通透的毛玻璃。",

  "constants": {
    "islandBlur": "30",
    "islandTint": { "light": "#F3F3F3", "dark": "#202020" },
    "islandOpacity": { "light": "0.5", "dark": "0.45" },
    "islandLuminosity": { "light": "0.8", "dark": "0.7" },
    "islandSaturation": "1.4",
    "islandNoise": "0.025",
    "barStroke": { "light": "#40FFFFFF", "dark": "#1AFFFFFF" },
    "monitorText": { "light": "#E4000000", "dark": "#FFFFFFFF" },
    "monitorSecondaryText": { "light": "#8A000000", "dark": "#B3FFFFFF" },
    "monitorWarning": { "light": "#FFC42B1C", "dark": "#FFFF99A4" },

    "menuRadius": "8",
    "menuBlur": "28",
    "menuTint": { "light": "#F3F3F3", "dark": "#1C1C1C" },
    "menuOpacity": { "light": "0.2", "dark": "0.25" },
    "menuLuminosity": { "light": "0.6", "dark": "0.5" },
    "menuSaturation": "1.5",
    "menuNoise": "0.025",
    "menuStroke": {
      "light": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#99FFFFFF\" Offset=\"0\"/><GradientStop Color=\"#33FFFFFF\" Offset=\"0.3\"/><GradientStop Color=\"#1A000000\" Offset=\"1\"/></LinearGradientBrush>",
      "dark": "<LinearGradientBrush StartPoint=\"0,0\" EndPoint=\"0,1\"><GradientStop Color=\"#4DFFFFFF\" Offset=\"0\"/><GradientStop Color=\"#1AFFFFFF\" Offset=\"0.3\"/><GradientStop Color=\"#0DFFFFFF\" Offset=\"1\"/></LinearGradientBrush>"
    },

    "barMaterial": "<DeskBlur BlurAmount=\"$islandBlur\" TintColor=\"$islandTint\" TintOpacity=\"$islandOpacity\" TintLuminosityOpacity=\"$islandLuminosity\" TintSaturation=\"$islandSaturation\" NoiseOpacity=\"$islandNoise\"/>",
    "menuMaterial": "<DeskBlur BlurAmount=\"$menuBlur\" TintColor=\"$menuTint\" TintOpacity=\"$menuOpacity\" TintLuminosityOpacity=\"$menuLuminosity\" TintSaturation=\"$menuSaturation\" NoiseOpacity=\"$menuNoise\"/>"
  },

  "taskbar": {
    "common": [
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundFill",
        "styles": ["Fill:=$barMaterial"]
      },
      // 顶部的分隔线改成一道淡淡的高光
      {
        "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke",
        "styles": ["Fill=$barStroke"]
      }
    ],
    "floating": [],
    "maximized": []
  },

  "startMenu": {
    "common": [
      {
        "target": "Border#AcrylicBorder",
        "styles": ["Background:=$menuMaterial", "BorderBrush:=$menuStroke", "BorderThickness=1", "CornerRadius=$menuRadius"]
      },
      {
        "target": "Border#AcrylicOverlay, Border#LayerBorder",
        "styles": ["Visibility=Collapsed"]
      },
      {
        "target": "Border#StartDropShadow, Border#RootGridDropShadow, Border#RightCompanionDropShadow",
        "styles": ["CornerRadius=$menuRadius"]
      }
    ]
  }
}
