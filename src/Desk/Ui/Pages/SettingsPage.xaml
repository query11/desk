<Page
    x:Class="Desk.Ui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Desk.Ui"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="设置">
    <StackPanel Style="{StaticResource Desk.Page}">
        <TextBlock Style="{StaticResource Desk.PageTitle}" Text="按你的习惯运行" />
        <TextBlock Style="{StaticResource Desk.Lead}" Text="管理启动、个人主题与诊断。关闭设置窗口后，Desk 会继续在托盘中运行。" />

        <TextBlock Style="{StaticResource Desk.FirstSectionHeader}" Text="启动" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="开机自动启动" Description="登录 Windows 后立即在后台启动（不显示窗口），比普通的开机启动项更早生效。">
                    <TextBlock
                        x:Name="AutostartStateText"
                        Margin="0,2,0,0"
                        Style="{StaticResource Desk.Caption}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </local:CardHeader>
            </ui:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing
                    x:Name="AutostartRing"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    IsIndeterminate="False"
                    Style="{StaticResource Desk.SmallRing}"
                    Visibility="Collapsed" />
                <ui:ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" />
            </Grid>
        </ui:CardControl>
        <ui:InfoBar
            x:Name="AutostartInfoBar"
            Margin="0,0,0,4"
            IsClosable="True" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Keyboard24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="快捷键" Description="随时停用或恢复美化，遇到问题时最快的办法。" />
            </ui:CardControl.Header>
            <ItemsControl AutomationProperties.Name="Ctrl + Alt + Shift + D" Style="{StaticResource Desk.Keys}">
                <sys:String>Ctrl</sys:String>
                <sys:String>Alt</sys:String>
                <sys:String>Shift</sys:String>
                <sys:String>D</sys:String>
            </ItemsControl>
        </ui:CardControl>

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="文件" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="FolderOpen24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="主题文件夹" Description="放在这里的主题会出现在主题列表里，保存后立即生效。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="ThemesFolderButton"
                Content="打开"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DocumentText24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="日志" Description="反馈问题时请附上这个文件夹里的日志。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="LogsFolderButton"
                Content="打开"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DocumentArrowDown24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="导出诊断" Description="把版本、系统和显示器信息、引擎状态、最近的错误以及 Desk 的日志打包成一个 zip，反馈问题时发给开发者。路径里的用户名会被替换。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="ExportDiagnosticsButton"
                Content="导出…"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>
        <ui:InfoBar
            x:Name="ExportInfoBar"
            Margin="0,0,0,4"
            IsClosable="True" />

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="关于" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Info24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader x:Name="VersionHeader" Description="以 GPL-3.0 发布。样式引擎参考了 TranslucentTB 和 Windhawk 的 Windows 11 Taskbar Styler，界面使用 WPF UI。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="ProjectButton"
                Content="项目主页"
                Style="{StaticResource Desk.CardButton}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </ui:Button.Icon>
            </ui:Button>
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="退出 Desk" Description="任务栏和开始菜单会恢复成系统原样。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="ExitButton"
                Content="退出并还原…"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>
    </StackPanel>
</Page>
