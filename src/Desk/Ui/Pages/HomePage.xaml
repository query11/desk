<Page
    x:Class="Desk.Ui.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Desk.Ui"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="概览">
    <StackPanel Style="{StaticResource Desk.Page}">

        <!--  The master switch, with the overall state at a glance.  -->
        <Border
            Padding="24,20"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="56"
                    Height="56"
                    VerticalAlignment="Center"
                    Source="pack://application:,,,/Desk;component/Assets/desk.png" />
                <StackPanel
                    Grid.Column="1"
                    Margin="20,0,16,0"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="桌面美化" />
                        <Border
                            x:Name="StatePill"
                            Margin="12,0,0,0"
                            Style="{StaticResource Desk.Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="StateDot"
                                    Width="6"
                                    Height="6"
                                    Margin="0,1,6,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StateText"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:Name="SummaryText"
                        Margin="0,6,0,0"
                        Style="{StaticResource Desk.Caption}"
                        FontSize="13" />
                </StackPanel>
                <ui:ToggleSwitch
                    x:Name="EnabledSwitch"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    OffContent="已停用"
                    OnContent="已启用" />
            </Grid>
        </Border>

        <ui:InfoBar
            x:Name="EngineErrorInfo"
            Title="引擎无法启动"
            Margin="0,12,0,0"
            IsClosable="False"
            Severity="Error" />
        <ui:InfoBar
            x:Name="OutdatedInfo"
            Title="Desk 已更新"
            Margin="0,12,0,0"
            IsClosable="False"
            Message="资源管理器里还在运行旧版本的引擎。重启资源管理器后，新的效果才会完全生效（打开的文件夹窗口会被关闭）。"
            Severity="Informational" />
        <ui:InfoBar
            x:Name="ConflictInfo"
            Title="可能有冲突"
            Margin="0,12,0,0"
            IsClosable="True"
            Severity="Warning" />

        <!--  Each status tile also leads to its page.  -->
        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="状态" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:CardAction
                x:Name="TaskbarTile"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="任务栏状态">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="TabDesktopBottom24" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <TextBlock Text="任务栏" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            x:Name="TaskbarStatusIcon"
                            VerticalAlignment="Top"
                            FontSize="16" />
                        <ui:ProgressRing
                            x:Name="TaskbarStatusRing"
                            Margin="0,1,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource Desk.SmallRing}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="TaskbarStatusText"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Style="{StaticResource Desk.Caption}" />
                    </Grid>
                </StackPanel>
            </ui:CardAction>
            <ui:CardAction
                x:Name="StartMenuTile"
                Grid.Column="2"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="开始菜单状态">
                <ui:CardAction.Icon>
                    <ui:SymbolIcon Symbol="Apps24" />
                </ui:CardAction.Icon>
                <StackPanel>
                    <TextBlock Text="开始菜单" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            x:Name="StartMenuStatusIcon"
                            VerticalAlignment="Top"
                            FontSize="16" />
                        <ui:ProgressRing
                            x:Name="StartMenuStatusRing"
                            Margin="0,1,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource Desk.SmallRing}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="StartMenuStatusText"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Style="{StaticResource Desk.Caption}" />
                    </Grid>
                </StackPanel>
            </ui:CardAction>
        </Grid>

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="主题" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="PaintBrush24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader x:Name="ThemeHeader" Title="当前主题" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="ThemeBox"
                MinWidth="240"
                DisplayMemberPath="Name" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="快捷操作" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSync24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="重新应用" Description="重新读取主题并重新连接任务栏和开始菜单。样式没有生效时可以试试。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="ReapplyButton"
                Content="重新应用"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowClockwise24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="重启资源管理器" Description="任务栏会消失几秒再出现，打开的文件夹窗口会被关闭。" />
            </ui:CardControl.Header>
            <ui:Button
                x:Name="RestartExplorerButton"
                Content="重启…"
                Style="{StaticResource Desk.CardButton}" />
        </ui:CardControl>

        <!--  The way out of trouble, always in view.  -->
        <Grid Margin="2,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ItemsControl Style="{StaticResource Desk.Keys}">
                <sys:String>Ctrl</sys:String>
                <sys:String>Alt</sys:String>
                <sys:String>Shift</sys:String>
                <sys:String>D</sys:String>
            </ItemsControl>
            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Desk.Footnote}"
                Text="随时停用或恢复美化。关闭这个窗口后，Desk 会留在托盘里继续工作。" />
        </Grid>
    </StackPanel>
</Page>
