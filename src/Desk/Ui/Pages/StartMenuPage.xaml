<Page
    x:Class="Desk.Ui.Pages.StartMenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Desk.Ui"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="开始菜单">
    <StackPanel Style="{StaticResource Desk.Page}">
        <TextBlock Style="{StaticResource Desk.PageTitle}" Text="每一次打开，都清爽" />
        <TextBlock Style="{StaticResource Desk.Lead}" Text="让开始菜单与任务栏保持同一种质感，平衡背景通透感与文字清晰度。" />

        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Apps24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="美化开始菜单" Description="把开始菜单的背景换成通透的毛玻璃。" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="StyleSwitch" />
        </ui:CardControl>
        <!--  Everything below changes the styled menu only; it is switched off with it.  -->
        <StackPanel x:Name="StyledOptions">
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DarkTheme24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="配色" Description="深色搭配白色文字，浅色搭配黑色文字；也可跟随系统。" />
            </ui:CardControl.Header>
            <ComboBox x:Name="SchemeBox" MinWidth="200">
                <ComboBoxItem Content="跟随 Windows 模式" />
                <ComboBoxItem Content="深色玻璃" />
                <ComboBoxItem Content="浅色玻璃" />
            </ComboBox>
        </ui:CardControl>

        <Grid Style="{StaticResource Desk.SectionBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock
                    Margin="0"
                    Style="{StaticResource Desk.SectionHeader}"
                    Text="玻璃效果" />
                <TextBlock
                    x:Name="ModeText"
                    Margin="0,2,0,0"
                    Style="{StaticResource Desk.Caption}" />
            </StackPanel>
            <ui:Button
                x:Name="ResetButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="恢复默认">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowReset24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ui:InfoBar
            x:Name="EmptyHint"
            Title="当前主题没有可以调整的参数"
            Margin="0,0,0,4"
            IsClosable="False"
            IsOpen="True"
            Message="自定义主题可以在主题文件里直接修改；内置主题都可以在这里调整。"
            Severity="Informational" />
        <StackPanel x:Name="ParametersPanel" />
        </StackPanel>

        <TextBlock Style="{StaticResource Desk.Footnote}" Text="开始菜单关着的时候也会更新，下次打开就能看到新的效果。" />
    </StackPanel>
</Page>
