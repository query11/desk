<Page
    x:Class="Desk.Ui.Pages.TaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Desk.Ui"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="任务栏">
    <StackPanel Style="{StaticResource Desk.Page}">
        <TextBlock Style="{StaticResource Desk.PageTitle}" Text="让常用应用，恰到好处" />
        <TextBlock Style="{StaticResource Desk.Lead}" Text="调整图标、材质和信息显示。修改会自动保存，并应用到桌面。" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock
                    Margin="0"
                    Style="{StaticResource Desk.SectionHeader}"
                    Text="外观与尺寸" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource Desk.Caption}"
                    Text="建议图标 28 px；大小与按钮间距可以分别调整。" />
            </StackPanel>
            <ui:Button
                x:Name="ResetButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="恢复默认">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowReset24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ui:InfoBar
            x:Name="EmptyHint"
            Title="当前主题没有可以调整的参数"
            Margin="0,0,0,4"
            IsClosable="False"
            IsOpen="True"
            Message="自定义主题可以在主题文件里直接修改；内置主题都可以在这里调整。"
            Severity="Informational" />
        <StackPanel x:Name="ParametersPanel" />

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="左侧信息岛" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DataUsage24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="显示网速和资源占用" Description="每秒更新，用颜色提示高占用。开启后替代天气按钮，Win + W 仍可打开小组件。" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="MonitorSwitch" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextBulletList24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="显示的内容" Description="信息岛打开后可选。" />
            </ui:CardControl.Header>
            <WrapPanel>
                <CheckBox
                    x:Name="MonitorNetworkBox"
                    MinWidth="0"
                    Margin="0,0,20,0"
                    Content="网速" />
                <CheckBox
                    x:Name="MonitorCpuBox"
                    MinWidth="0"
                    Margin="0,0,20,0"
                    Content="CPU" />
                <CheckBox
                    x:Name="MonitorMemoryBox"
                    MinWidth="0"
                    Content="内存" />
            </WrapPanel>
        </ui:CardControl>

        <TextBlock Style="{StaticResource Desk.SectionHeader}" Text="行为" />
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Maximize24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="窗口最大化时" Description="有窗口铺满屏幕时，任务栏怎么显示。" />
            </ui:CardControl.Header>
            <ComboBox x:Name="MaximizeBox" MinWidth="200">
                <ComboBoxItem Content="恢复成整条任务栏" />
                <ComboBoxItem Content="自动隐藏任务栏" />
                <ComboBoxItem Content="保持浮岛" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="CursorClick24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <local:CardHeader Title="空白处点击穿透（实验）" Description="点击浮岛之间的空白处时，点到后面的窗口或桌面。" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ClickThroughSwitch" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource Desk.Footnote}" Text="这里调整的数值保存在 Desk 的设置里，不会改动主题文件。透明程度和明暗统一在浅色、深色模式下分别保存。" />
    </StackPanel>
</Page>
