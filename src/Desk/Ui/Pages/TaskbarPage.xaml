<Page
    x:Class="Desk.Ui.Pages.TaskbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="任务栏">
    <StackPanel Margin="40,8,40,40">
        <TextBlock
            Margin="0,0,0,20"
            FontSize="28"
            FontWeight="SemiBold"
            Text="任务栏" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="浮岛外观" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="每一项下面都有说明。拖动滑块，任务栏会立即跟着变化；不满意随时点「恢复默认」。"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button
                x:Name="ResetButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="恢复默认">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowReset24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ui:InfoBar
            x:Name="EmptyHint"
            Title="当前主题没有可以调整的参数"
            Margin="0,0,0,8"
            IsClosable="False"
            IsOpen="True"
            Message="自定义主题可以在主题文件里直接修改；内置主题都可以在这里调整。"
            Severity="Informational" />
        <StackPanel x:Name="ParametersPanel" />

        <TextBlock
            Margin="0,28,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Text="左侧信息岛" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DataUsage24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="显示网速和资源占用" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="在任务栏最左边放一个和其他浮岛同样质感的小岛，每秒刷新上传/下载速度和 CPU、内存占用，占用超过 85% 时数字变红。打开后系统的小组件（天气）按钮会隐藏，按 Win + W 仍可打开小组件。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="MonitorSwitch" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextBulletList24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <TextBlock VerticalAlignment="Center" Text="显示的内容" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    x:Name="MonitorNetworkBox"
                    MinWidth="0"
                    Margin="0,0,20,0"
                    Content="网速" />
                <CheckBox
                    x:Name="MonitorCpuBox"
                    MinWidth="0"
                    Margin="0,0,20,0"
                    Content="CPU" />
                <CheckBox
                    x:Name="MonitorMemoryBox"
                    MinWidth="0"
                    Content="内存" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock
            Margin="0,28,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Text="行为" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Maximize24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="窗口最大化时" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="有窗口铺满屏幕时，任务栏怎么显示。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="MaximizeBox" MinWidth="200">
                <ComboBoxItem Content="恢复成整条任务栏" />
                <ComboBoxItem Content="自动隐藏任务栏" />
                <ComboBoxItem Content="保持浮岛" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="CursorClick24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="空白处点击穿透（实验）" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="点击浮岛之间的空白处时，点到后面的窗口或桌面。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ClickThroughSwitch" />
        </ui:CardControl>

        <TextBlock
            Margin="2,16,0,0"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
            Text="这里调整的数值保存在 Desk 的设置里，不会改动主题文件。着色浓度和明暗统一在浅色、深色模式下分别保存。"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>
