<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        The settings window's design language, in one place. Colors always
        come from WPF UI's theme brushes (as DynamicResource, so the window
        follows light and dark mode live); sizes follow the Windows 11
        Settings layout on a 4 px grid: 4 between cards, 28 above a section,
        40 around the page.
    -->

    <sys:Double x:Key="Desk.ContentMaxWidth">1000</sys:Double>

    <!--  Pages: the scrolling column and the pinned title above it share a width.  -->
    <Style x:Key="Desk.Page" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource Desk.ContentMaxWidth}" />
    </Style>

    <!--  Cards stack with a 4 px gap, like in Windows Settings.  -->
    <Style BasedOn="{StaticResource DefaultUiCardControlStyle}" TargetType="ui:CardControl">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  Type ramp (Fluent): section headers, secondary lines, footnotes.  -->
    <Style x:Key="Desk.SectionHeader" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,28,0,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="Desk.FirstSectionHeader"
        BasedOn="{StaticResource Desk.SectionHeader}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Desk.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Desk.Footnote" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,20,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Section header with an action (such as "恢复默认") on the right.  -->
    <Style x:Key="Desk.SectionBar" TargetType="Grid">
        <Setter Property="Margin" Value="0,28,0,8" />
    </Style>

    <!--  Buttons at the right of a card line up.  -->
    <Style
        x:Key="Desk.CardButton"
        BasedOn="{StaticResource DefaultUiButtonStyle}"
        TargetType="ui:Button">
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <!--  Keyboard keys, for shortcuts: Ctrl  Alt  Shift  D  -->
    <Style x:Key="Desk.Keys" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border
                        MinWidth="24"
                        Margin="0,0,4,0"
                        Padding="7,2,7,3"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1,1,1,2"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding}" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A small rounded status label; its colors are set from code.  -->
    <Style x:Key="Desk.Pill" TargetType="Border">
        <Setter Property="Padding" Value="8,2,10,3" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  A spinner the size of a 16 px icon.  -->
    <Style
        x:Key="Desk.SmallRing"
        BasedOn="{StaticResource {x:Type ui:ProgressRing}}"
        TargetType="ui:ProgressRing">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="CoverRingVisibility" Value="Collapsed" />
    </Style>
</ResourceDictionary>
